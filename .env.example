# Copy to .env and fill in. Never commit the real .env.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (docker compose up -d starts one with these values)
DB_NAME=onlinechat
DB_USER=onlinechat_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Redis: channel layer, presence and cache
REDIS_HOST=localhost
REDIS_PORT=6379

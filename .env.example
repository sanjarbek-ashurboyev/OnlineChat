# Copy to .env and fill in. Never commit the real .env.

# Django
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production only: comma-separated, with scheme, e.g. https://chat.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Production only (DJANGO_DEBUG=False). Raise HSTS once HTTPS is known to work.
# DJANGO_SSL_REDIRECT=True
# DJANGO_HSTS_SECONDS=3600
# DJANGO_HSTS_INCLUDE_SUBDOMAINS=False
# DJANGO_HSTS_PRELOAD=False

# PostgreSQL (docker compose up -d starts one with these values)
DB_NAME=onlinechat
DB_USER=onlinechat_user
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Redis: channel layer, presence and cache
REDIS_HOST=localhost
REDIS_PORT=6379
